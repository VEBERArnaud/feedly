{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "feedly.opml",
            "label": "Feedly OPML"
          },
          {
            "path": "feedme-nested.opml",
            "label": "Nested OPML"
          }
        ]
      }
    ]
  ]
}
